# Variables de Entorno — DMT Sistema v2 (Vercel + Neon)
# En local: copiar como .env.local, o mejor:
#   npx vercel env pull .env.local --environment=production
# NUNCA commitear .env.local

# ─── Base de datos (Neon; las crea la integración de Vercel) ───
# Pooled: la usa la app
DATABASE_URL=
# Directa (sin -pooler): la usan las migraciones (prisma migrate deploy)
DATABASE_URL_UNPOOLED=

# ─── Auth.js ───────────────────────────────────────────
# Obligatoria en producción. Generar con: openssl rand -base64 32
AUTH_SECRET=

# ─── URLs públicas (links de email, QR y WhatsApp) ─────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=America/Bogota

# ─── Email SMTP (valores por defecto; cada evento puede tener los suyos) ───
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Email por Resend (opcional, alternativa a SMTP) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Login con Google (opcional) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Endpoint de un solo uso /api/admin/bootstrap (opcional) ───
BOOTSTRAP_ADMIN_SECRET=
