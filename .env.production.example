# Copiar como .env.production EN EL SERVIDOR (nunca se sube a git).
# deploy/setup-vps.sh genera los secretos automáticamente.

# Dominio público. Sin dominio propio: <ip-con-guiones>.sslip.io (ej. 129-146-10-20.sslip.io)
DOMAIN=

# Contraseña de Postgres (solo se usa dentro de Docker)
POSTGRES_PASSWORD=

# Auth.js — obligatorio. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Endpoint /api/admin/bootstrap (opcional)
BOOTSTRAP_ADMIN_SECRET=

# Email por SMTP (valores por defecto; cada evento puede tener los suyos)
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email por Resend (opcional, alternativa a SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_TIMEZONE=America/Bogota
BACKUP_KEEP_DAYS=14
